#!/bin/bash
echo "Mock Hysteria2 Client"
echo "======================"
echo "Server: $2"
echo "Config: $1"

if [ "$1" = "-c" ] && [ "$2" = "client" ]; then
    echo "Starting mock Hysteria2 client..."
    echo "Connected to server"
    echo "SOCKS5 proxy listening on 127.0.0.1:1080"
    echo "HTTP proxy listening on 127.0.0.1:1081"
    
    # Keep running for 30 seconds then exit
    sleep 30
    echo "Mock client stopped"
else
    echo "Usage: hysteria-mock -c <config.json> client"
    exit 1
fi
